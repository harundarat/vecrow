# Vecrow backend configuration. Copy to .env and adjust; .env is never committed.
# Real environment variables take precedence over values in .env.
# Values are unquoted because the Makefile includes this file.

# --- Application -------------------------------------------------------------
# development | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
# json | text (empty: json in production, text otherwise)
LOG_FORMAT=text

# --- HTTP (api) --------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
# Comma-separated frontend origins, each starting with http:// or https:// (no spaces);
# "*" allows any origin without credentials; set but empty disables CORS; unset uses the default.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated proxy IPs/CIDRs trusted for X-Forwarded-For; empty trusts none.
TRUSTED_PROXIES=

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgres://vecrow:vecrow@localhost:5432/vecrow?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

# --- Cache (Redis) -----------------------------------------------------------
CACHE_URL=redis://localhost:6379/0

# --- Queue (RabbitMQ, worker only) -------------------------------------------
QUEUE_URL=amqp://vecrow:vecrow@localhost:5672/
# Unacked messages and concurrent handlers per topic.
QUEUE_PREFETCH=10
# Retries after the first attempt before a message is dead-lettered.
QUEUE_MAX_RETRIES=5
QUEUE_RETRY_DELAY=30s
QUEUE_HANDLER_TIMEOUT=60s

# --- Scheduler (worker) ------------------------------------------------------
SCHEDULER_INTERVAL=30s

# --- Auth --------------------------------------------------------------------
AUTH_NONCE_TTL=5m
