# Vecrow backend configuration. Copy to .env and adjust; .env is never committed.
# Real environment variables take precedence over values in .env.
# Values are unquoted because the Makefile includes this file.

# --- Application -------------------------------------------------------------
# development | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
# json | text (empty: json in production, text otherwise)
LOG_FORMAT=text

# --- HTTP (api) --------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
# Comma-separated frontend origins, each starting with http:// or https:// (no spaces);
# "*" allows any origin without credentials; set but empty disables CORS; unset uses the default.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated proxy IPs/CIDRs trusted for X-Forwarded-For; empty trusts none.
TRUSTED_PROXIES=

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgres://vecrow:vecrow@localhost:5432/vecrow?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

# --- Cache (Redis) -----------------------------------------------------------
CACHE_URL=redis://localhost:6379/0

# --- Queue (RabbitMQ, worker only) -------------------------------------------
QUEUE_URL=amqp://vecrow:vecrow@localhost:5672/
# Unacked messages and concurrent handlers per topic.
QUEUE_PREFETCH=10
# Retries after the first attempt before a message is dead-lettered.
QUEUE_MAX_RETRIES=5
QUEUE_RETRY_DELAY=30s
QUEUE_HANDLER_TIMEOUT=60s

# --- Scheduler (worker) ------------------------------------------------------
SCHEDULER_INTERVAL=30s

# --- Auth (api) --------------------------------------------------------------
AUTH_NONCE_TTL=5m
# Host shown in the login message users sign, and the NEP-413 recipient NEAR
# wallets sign for. Use the frontend's host (no scheme), e.g. app.vecrow.xyz.
AUTH_DOMAIN=localhost:5173
# Lifetime of a bearer session token issued by POST /auth/verify.
AUTH_SESSION_TTL=24h
# Lifetime of the guest token the other party of an escrow receives (X-Guest-Token).
AUTH_GUEST_TOKEN_TTL=24h

# --- Mail (api) --------------------------------------------------------------
# SMTP server for one-time codes (email verification, account recovery) and
# account notifications. Required in production. Without SMTP_HOST, in
# development, emails are not sent: a log line shows the masked recipient and
# the subject, never the body (one-time codes are never logged). To read the
# emails locally, run a mail catcher such as Mailpit on localhost:1025 with
# SMTP_TLS=none.
SMTP_HOST=
# 587 with SMTP_TLS=starttls, 465 with SMTP_TLS=tls.
SMTP_PORT=587
# Optional AUTH PLAIN credentials, sent only over TLS (or to localhost). Never
# commit the password.
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (required STARTTLS upgrade) | tls (implicit TLS) | none (localhost
# mail catcher only)
SMTP_TLS=starttls
# Bounds one email, from connecting to QUIT.
SMTP_TIMEOUT=10s
# Sender address, e.g. Vecrow <no-reply@vecrow.xyz>.
SMTP_FROM=

# --- NEAR (api, worker) ------------------------------------------------------
# JSON-RPC endpoint for views (login keys, get_escrow) and for sending
# transactions. The public endpoint is rate limited; use a provider in production.
NEAR_RPC_URL=https://rpc.testnet.near.org
# Prefix of transaction links in GET /escrows/:id (the hash is appended).
NEAR_EXPLORER_TX_URL=https://testnet.nearblocks.io/txns/

# --- Escrow contract (api, worker) -------------------------------------------
# The Vecrow escrow contract, and the NEP-141 token it holds (USDC; a mock
# token locally and on testnet).
ESCROW_CONTRACT_ID=
USDC_CONTRACT_ID=
# Must equal the fee_bps the contract was deployed with: the contract rejects
# terms with another fee, and has no view to read it.
ESCROW_FEE_BPS=
# How long terms stay valid for signing (their deadline_ms).
ESCROW_TERMS_TTL=24h
# Wait after a deadline before an approved escrow not yet on-chain reopens.
ESCROW_EXPIRY_GRACE=5m
# Frontend base URL; escrow links are APP_URL/escrows/{id}.
APP_URL=http://localhost:5173

# --- Relayer (api, worker) ---------------------------------------------------
# Sends create_escrow, signed approver actions, auto_release, retry_payout and
# the freelancer's delegate actions (NEP-366), paying their gas. It gains no
# rights in the contract. The key is "ed25519:<base58>"; never commit it.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
# Maximum gas, in TGas, of a relayed delegate action's function call.
RELAYER_MAX_GAS_TGAS=100

# --- Storage account (worker) ------------------------------------------------
# Pays the USDC storage deposits of payout recipients and refund accounts
# before create_escrow and retry_payout. Never commit the key.
STORAGE_ACCOUNT_ID=
STORAGE_PRIVATE_KEY=

# --- 1Click (api, worker) ----------------------------------------------------
ONECLICK_URL=https://1click.chaindefuser.com
# Optional JWT from the 1Click partner portal; quotes without one pay an extra fee.
ONECLICK_API_KEY=
ONECLICK_SLIPPAGE_BPS=100
# How long a quote's deposit address is valid.
ONECLICK_QUOTE_TTL=1h
# How long after a quote's deadline its status is still watched.
ONECLICK_WATCH_GRACE=24h
# Age after which GET /escrows/:id/funding reads the status from 1Click again.
ONECLICK_REFRESH_AFTER=10s
# How long the token list (GET /tokens) is cached.
ONECLICK_TOKENS_TTL=5m

# --- Jobs (worker) -----------------------------------------------------------
# How often an escrow on-chain is read again to catch changes made elsewhere.
JOB_SYNC_INTERVAL=5m
# How often a watched 1Click quote's status is checked.
JOB_FUNDING_INTERVAL=30s
# Maximum items of each kind one scheduler run publishes.
JOB_BATCH_SIZE=100
# How long a published job is not published again (a lease in Redis).
JOB_LEASE_TTL=2m
